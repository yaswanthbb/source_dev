# App & Environment
PORT=3000
NODE_ENV=production

# Database (Option A: Cloud single connection string like Neon / Render)
DATABASE_URL=postgres://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_SSL=true

# Database (Option B: Individual parameters for local dev)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_DATABASE=source-dev

# Security & JWT
JWT_SECRET=super-secret-jwt-key
JWT_EXPIRES_IN=24h

# CORS & Frontend URLs
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000,http://localhost:3001

# AI generation: Gemini is the shared platform default; caller keys take precedence.
# Set GEMINI_API_KEY on Render. Both fast and strong tiers default to gemini-3.6-flash.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_ID=gemini-3.6-flash
GEMINI_STRONG_MODEL_ID=
# JSON requests use MINIMAL thinking with thought output excluded. Gemini 3.6
# does not support disabling thinking; thinkingBudget=0 is not a zero-thinking guarantee.
# NVIDIA stays available by explicit provider selection or a caller-owned key.
# Provider failures suggest switching; requests never automatically cross providers.
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA JSON/schema-bound work requires a non-thinking instruct model.
# Strong resolution: NVIDIA_STRONG_MODEL_ID -> NVIDIA_MODEL_ID -> curated default.
# Per-call, saved-key and queued-job model overrides can take precedence.
# Batch jobs pin the fast default: configure both tiers, then start a fresh job.
# Legacy example below is preserved; this hosted model returned 410 on 2026-11-02.
NVIDIA_MODEL_ID=meta/llama-3.1-70b-instruct
NVIDIA_STRONG_MODEL_ID=

# BYOK key custody (AES-256-GCM master secret, 32 bytes hex-encoded = 64 hex chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production (boot refuses without it); dev falls back to an
# ephemeral key with a warning (stored keys won't survive restarts).
AI_KEYS_ENCRYPTION_SECRET=

# Email Service (Gmail SMTP)
EMAIL_USER=your-gmail@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password

# OAuth - Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-backend.onrender.com/auth/google/callback

# OAuth - GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://your-backend.onrender.com/auth/github/callback


